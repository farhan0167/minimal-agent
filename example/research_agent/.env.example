# Copy to `.env` and fill in. `uv run main.py` loads it automatically.

# API key for your backend. This example defaults to OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# Model name. Any model on OpenRouter.
LLM_MODEL=openai/gpt-4o-mini

# openrouter (default here), openai, anthropic, or localhost.
LLM_BACKEND=openrouter

# Enables the web_search / web_extract tools. Get one at https://tavily.com.
TAVILY_API_KEY=tvly-...
