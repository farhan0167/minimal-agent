# Copy to `.env` and fill in. `uv run main.py` loads it automatically.

# API key for your backend. Required.
OPENAI_API_KEY=sk-...

# Model name. Defaults to gpt-4o-mini.
LLM_MODEL=gpt-4o-mini

# openai (default), anthropic, openrouter, or localhost.
LLM_BACKEND=openai

# Enables the web_search / web_extract tools. Get one at https://tavily.com.
TAVILY_API_KEY=tvly-...
